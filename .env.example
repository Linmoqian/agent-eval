# API Key 配置模板：复制为 .env 并填入真实值（.env 不入库）
# 变量命名统一：<VENDOR>_API_KEY + <VENDOR>_MODEL

# OpenAI
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（OpenAI 兼容，base https://api.deepseek.com/v1）
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM（OpenAI 兼容，base https://open.bigmodel.cn/api/paas/v4）
ZHIPU_API_KEY=xxxx.xxxx
ZHIPU_MODEL=glm-4.5

# Moonshot Kimi K3（OpenAI 兼容，base https://api.moonshot.cn/v1）
MOONSHOT_API_KEY=sk-xxxx
MOONSHOT_MODEL=kimi-k3

# Anthropic Claude（base https://api.anthropic.com/v1）
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# xAI Grok（OpenAI 兼容，base https://api.x.ai/v1）
GROK_API_KEY=xai-xxxx
GROK_MODEL=grok-4

# Google Gemini（OpenAI 兼容端点 https://generativelanguage.googleapis.com/v1beta/openai）
GEMINI_API_KEY=AIza-xxxx
GEMINI_MODEL=gemini-2.5-pro

# 阿里通义千问 Qwen（OpenAI 兼容，base https://dashscope.aliyuncs.com/compatible-mode/v1）
QWEN_API_KEY=sk-xxxx
QWEN_MODEL=qwen-max
